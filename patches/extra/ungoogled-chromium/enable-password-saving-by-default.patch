# Enable the password manager ("Offer to save passwords and passkeys") by
# default. Chromium 156 flipped the upstream default of
# credentials_enable_service from on to off, so fresh profiles no longer get
# the "Save password?" prompt. EDI restores the on-by-default behavior; the
# user can still turn the setting off in chrome://password-manager/settings.

--- a/components/password_manager/core/browser/password_manager.cc
+++ b/components/password_manager/core/browser/password_manager.cc
@@ -549,8 +549,8 @@ void PasswordManager::RegisterProfilePrefs(
 // static
 void PasswordManager::RegisterProfilePrefs(
     user_prefs::PrefRegistrySyncable* registry) {
   registry->RegisterBooleanPref(
-      prefs::kCredentialsEnableService, false,
+      prefs::kCredentialsEnableService, true,
       user_prefs::PrefRegistrySyncable::SYNCABLE_PRIORITY_PREF);
   registry->RegisterBooleanPref(
       prefs::kCredentialsEnableAutosignin, false,
