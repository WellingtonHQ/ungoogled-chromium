diff --git a/chrome/installer/setup/install_worker.cc b/chrome/installer/setup/install_worker.cc
index 1a930947cc..53918aef8f 100644
--- a/chrome/installer/setup/install_worker.cc
+++ b/chrome/installer/setup/install_worker.cc
@@ -343,6 +343,14 @@ void AddChromeWorkItems(const InstallParams& install_params,
           WorkItem::MoveTreeOptions{.lenient_deletion = true})),
       /*else_item=*/std::move(not_in_use_list)));
 
+  // Move the EDI MCP sidecar into the install root. It is staged next to
+  // chrome.exe (outside the version directory), so it needs its own item.
+  // Allow items in `src_path` to be left behind. It is in a temporary
+  // directory that will eventually be cleaned up.
+  install_list->AddMoveTreeWorkItem(
+      src_path.Append(installer::kEdiExe), target_path.Append(installer::kEdiExe),
+      temp_path, WorkItem::MoveTreeOptions{.lenient_deletion = true});
+
   // Update the version key now that chrome.exe or new_chrome.exe is in place.
   AddVersionKeyWorkItems(install_params, install_list);
 
