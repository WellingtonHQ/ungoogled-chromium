+
+bool McpSidecarLauncher::IsRunning() const {
+  if (!process_.IsValid()) {
+    return false;
+  }
+  // Non-blocking: a false return means the sidecar has not exited.
+  int exit_code = 0;
+  return !process_.WaitForExitWithTimeout(base::TimeDelta(), &exit_code);
+}
