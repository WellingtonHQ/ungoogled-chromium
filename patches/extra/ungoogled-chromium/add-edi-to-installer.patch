+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+
+# Copyright (c) 2026 The ungoogled-chromium Authors. All rights reserved.
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+"""Copies the EDI MCP sidecar binary into the build output directory.
+
+The sidecar (edi.exe) is built separately from the browser (a Rust release
+build in the EDI workspace) and is copied next to chrome.exe so that the
+browser's built-in launcher can find it and the Windows installer packages
+it alongside the browser.
+"""
+
+import shutil
+import sys
+
+
+def main():
+    if len(sys.argv) != 3:
+        raise SystemExit('usage: copy_edi_sidecar.py <source> <destination>')
+    shutil.copyfile(sys.argv[1], sys.argv[2])
+
+
+if __name__ == '__main__':
+    main()
