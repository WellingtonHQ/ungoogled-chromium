+// Copyright (c) 2026 The ungoogled-chromium Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/mcp_sidecar_launcher.h"
+
+#include "base/files/file_util.h"
+#include "base/logging.h"
+#include "base/process/launch.h"
+#include "base/time/time.h"
+#include "build/build_config.h"
+
+namespace {
+
+// How often the supervisor checks the sidecar's state.
+const base::TimeDelta kSuperviseInterval = base::Seconds(2);
+
+}  // namespace
+
+std::unique_ptr<McpSidecarLauncher> McpSidecarLauncher::Start(
+    const base::FilePath& exe_dir, const base::FilePath& profile_dir) {
+  const base::FilePath exe_path = exe_dir.Append(kSidecarExecutableName);
+  if (!base::PathExists(exe_path)) {
+    LOG(WARNING) << "EDI sidecar not found at " << exe_path.value()
+                 << "; the browser will start without the built-in MCP server.";
+    return nullptr;
+  }
+
+  base::Process process = LaunchSidecar(exe_path, profile_dir);
+  if (!process.IsValid()) {
+    LOG(WARNING) << "Failed to launch the EDI sidecar at "
+                 << exe_path.value();
+    return nullptr;
+  }
+
+  return std::make_unique<McpSidecarLauncher>(std::move(process),
+                                              std::move(exe_path),
+                                              profile_dir);
+}
+
+McpSidecarLauncher::McpSidecarLauncher(base::Process process,
+                                       const base::FilePath& exe_path,
+                                       const base::FilePath& profile_dir)
+    : process_(std::move(process)),
+      exe_path_(exe_path),
+      profile_dir_(profile_dir) {
+  timer_.Start(FROM_HERE, kSuperviseInterval, this,
+               &McpSidecarLauncher::OnSuperviseTimerFired);
+}
+
+McpSidecarLauncher::~McpSidecarLauncher() {
+  // A destroyed launcher must never relaunch the sidecar, even if the browser
+  // process is tearing down.
+  Shutdown();
+}
+
+void McpSidecarLauncher::Shutdown() {
+  shutting_down_ = true;
+  timer_.Stop();
+}
+
+base::Process McpSidecarLauncher::LaunchSidecar(
+    const base::FilePath& exe_path, const base::FilePath& profile_dir) {
+  base::CommandLine command_line(exe_path);
+  // The sidecar CLI takes the flag and its value as separate arguments:
+  //   edi.exe --profile-dir <profile_dir>
+  command_line.AppendArg("--profile-dir");
+  command_line.AppendArgPath(profile_dir);
+
+  base::LaunchOptions options;
+#if BUILDFLAG(IS_WIN)
+  // The sidecar is a background service and must not open a console window.
+  options.start_hidden = true;
+#endif  // BUILDFLAG(IS_WIN)
+
+  return base::LaunchProcess(command_line, options);
+}
+
+void McpSidecarLauncher::OnSuperviseTimerFired() {
+  if (shutting_down_) {
+    timer_.Stop();
+    return;
+  }
+  if (!process_.IsValid()) {
+    timer_.Stop();
+    return;
+  }
+
+  // Non-blocking: returns true, with the exit code, only if the sidecar has
+  // already exited.
+  int exit_code = 0;
+  if (!process_.WaitForExitWithTimeout(base::TimeDelta(), &exit_code)) {
+    return;  // The sidecar is still running.
+  }
+
+  if (exit_code == kSidecarExitPortConflict && relaunches_remaining_ > 0) {
+    relaunches_remaining_--;
+    LOG(INFO) << "EDI sidecar exited with the port-conflict code " << exit_code
+              << "; relaunching it (" << relaunches_remaining_
+              << " relaunch(es) remaining).";
+    base::Process relaunched = LaunchSidecar(exe_path_, profile_dir_);
+    if (relaunched.IsValid()) {
+      process_ = std::move(relaunched);
+      return;  // Keep supervising the new process.
+    }
+    LOG(WARNING) << "Failed to relaunch the EDI sidecar at "
+                 << exe_path_.value();
+  } else {
+    LOG(INFO) << "EDI sidecar exited with code " << exit_code
+              << "; stopping supervision.";
+  }
+
+  timer_.Stop();
+}
