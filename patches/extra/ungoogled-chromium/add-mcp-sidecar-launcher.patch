+// Launches and supervises the EDI MCP sidecar (edi.exe), a standalone
+// process bundled next to the browser executable that serves the built-in
+// Model Context Protocol (MCP) endpoint over loopback.
+//
+// The launcher is deliberately minimal: it only spawns the sidecar with the
+// browser's user-data (profile) directory and watches the sidecar's exit
+// code. It performs no network I/O and reads or writes no files of its own;
+// CDP discovery (DevToolsActivePort) and the MCP transport are the
+// sidecar's own responsibility.
+//
+// All methods must be called on the browser process UI thread.
+
+#ifndef CHROME_BROWSER_MCP_SIDECAR_LAUNCHER_H_
+#define CHROME_BROWSER_MCP_SIDECAR_LAUNCHER_H_
+
+#include <memory>
+
+#include "base/files/file_path.h"
+#include "base/process/process.h"
+#include "base/timer/timer.h"
+
+// Locates the bundled EDI sidecar executable and, if present, spawns and
+// supervises it for the lifetime of the browser process.
+class McpSidecarLauncher {
+ public:
+  // Locates the sidecar executable (edi.exe) in |exe_dir| and, if present,
+  // spawns it with `--profile-dir <profile_dir>` and starts supervising it.
+  //
+  // Returns nullptr, after logging a warning, if the sidecar executable is
+  // missing or cannot be launched; the browser starts and runs normally
+  // without the sidecar in either case.
+  //
+  // Must be called on the browser process UI thread.
+  static std::unique_ptr<McpSidecarLauncher> Start(
+      const base::FilePath& exe_dir, const base::FilePath& profile_dir);
+
+  McpSidecarLauncher(const McpSidecarLauncher&) = delete;
+  McpSidecarLauncher& operator=(const McpSidecarLauncher&) = delete;
+
+  // Stops supervising the sidecar. Safe to call more than once. Call this
+  // during a clean browser shutdown so that a sidecar exit triggered by the
+  // browser going away is never treated as a relaunchable failure.
+  void Shutdown();
+
+  ~McpSidecarLauncher();
+
+ private:
+  McpSidecarLauncher(base::Process process,
+                     const base::FilePath& exe_path,
+                     const base::FilePath& profile_dir);
+
+  // Spawns the sidecar executable. Returns an invalid process if the launch
+  // failed.
+  static base::Process LaunchSidecar(const base::FilePath& exe_path,
+                                     const base::FilePath& profile_dir);
+
+  // Invoked periodically by |timer_| to check whether the sidecar has exited,
+  // and to relaunch it if it exited with the port-conflict code.
+  void OnSuperviseTimerFired();
+
+  // The sidecar's executable file name, expected next to the browser
+  // executable.
+  static constexpr char kSidecarExecutableName[] = "edi.exe";
+  // The browser switch that marks this launch as the agent browser. The agent
+  // browser's sidecar uses the fixed MCP endpoint from the user environment
+  // (EDI_BIND_PORT / EDI_MCP_TOKEN) so a static MCP client config always
+  // points at the same URL; every other browser gets an ephemeral port and a
+  // fresh token so several EDI browsers can run side by side.
+  static constexpr char kEdiAgentSwitch[] = "edi-agent";
+  // The environment variable the sidecar reads its bearer token from.
+  static constexpr wchar_t kSidecarTokenEnv[] = L"EDI_MCP_TOKEN";
+  // The sidecar's exit code meaning its MCP port is already in use; the
+  // sidecar expects to be relaunched so it can pick a different port.
+  static constexpr int kSidecarExitPortConflict = 2;
+  // The maximum number of times the sidecar is relaunched after a
+  // port-conflict exit.
+  static constexpr int kMaxRelaunches = 1;
+
+  base::Process process_;
+  const base::FilePath exe_path_;
+  const base::FilePath profile_dir_;
+  // Relaunches still allowed after a port-conflict exit.
+  int relaunches_remaining_ = kMaxRelaunches;
+  // Set by Shutdown(); prevents any relaunch during browser shutdown.
+  bool shutting_down_ = false;
+  base::RepeatingTimer timer_;
+};
+
+#endif  // CHROME_BROWSER_MCP_SIDECAR_LAUNCHER_H_
