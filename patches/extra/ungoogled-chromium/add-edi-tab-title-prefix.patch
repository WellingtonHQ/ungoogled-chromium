--- /dev/null
+++ b/chrome/browser/edi/edi_tab_title_prefix.cc
@@ -0,0 +1,25 @@
+// Copyright (c) 2026 Wellington Moreno. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/edi/edi_tab_title_prefix.h"
+
+#include "base/check.h"
+#include "components/tabs/public/tab_interface.h"
+
+EdiTabTitlePrefix::EdiTabTitlePrefix(tabs::TabInterface& tab)
+    : scoped_unowned_user_data_(tab.GetUnownedUserDataHost(), *this) {}
+
+// static
+EdiTabTitlePrefix* EdiTabTitlePrefix::From(tabs::TabInterface* tab) {
+  DCHECK(tab);
+  if (EdiTabTitlePrefix* existing =
+          Get(tab->GetUnownedUserDataHost())) {
+    return existing;
+  }
+  return new EdiTabTitlePrefix(*tab);
+}
+
+void EdiTabTitlePrefix::SetPrefix(const std::u16string& prefix) {
+  prefix_ = prefix;
+}
