+// Copyright (c) 2026 Wellington Moreno. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// A display-only title prefix for agent-owned tabs, stored as unowned user
+// data on the tab. The prefix is prepended to the title the tab strip
+// shows; the underlying document title is untouched.
+
+#ifndef CHROME_BROWSER_EDI_EDIT_TAB_TITLE_PREFIX_H_
+#define CHROME_BROWSER_EDI_EDIT_TAB_TITLE_PREFIX_H_
+
+#include <string>
+
+#include "ui/base/unowned_user_data/scoped_unowned_user_data.h"
+
+namespace tabs {
+class TabInterface;
+}
+
+class EdiTabTitlePrefix {
+ public:
+  DECLARE_USER_DATA(EdiTabTitlePrefix);
+
+  explicit EdiTabTitlePrefix(tabs::TabInterface& tab);
+  ~EdiTabTitlePrefix() = default;
+
+  EdiTabTitlePrefix(const EdiTabTitlePrefix&) = delete;
+  EdiTabTitlePrefix& operator=(const EdiTabTitlePrefix&) = delete;
+
+  // The prefix for |tab|, creating it if needed. |tab| must be non-null.
+  static EdiTabTitlePrefix* From(tabs::TabInterface* tab);
+
+  // Sets the display prefix; an empty prefix clears it.
+  void SetPrefix(const std::u16string& prefix);
+
+  // The current display prefix (empty if none).
+  const std::u16string& prefix() const { return prefix_; }
+
+ private:
+  std::u16string prefix_;
+  ui::ScopedUnownedUserData<EdiTabTitlePrefix> scoped_unowned_user_data_;
+};
+
+#endif  // CHROME_BROWSER_EDI_EDIT_TAB_TITLE_PREFIX_H_
diff --git a/chrome/browser/edi/edi_tab_title_prefix.cc b/chrome/browser/edi/edi_tab_title_prefix.cc
new file mode 100644
