+# Copyright (c) 2026 Wellington Moreno. All rights reserved.
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+# The Edi domain exposes EDI browser-specific operations to CDP clients:
+# tab group management and display-only tab title prefixes. It is used by
+# the built-in MCP sidecar to give the agent its own labeled group of tabs
+# inside the user's browser window.
+domain Edi
+  # Information about a tab group.
+  type TabGroupInfo extends object
+    properties
+      # The unique identifier of the group.
+      string id
+      # The group title.
+      string title
+      # The group color id.
+      integer color
+      # The CDP target ids of the tabs currently in the group.
+      array of string tabIds
+
+  # Attaches the tab |targetId| to a tab group. When |groupId| is empty or
+  # does not name an existing group, a new group is created with |title|
+  # and |color| (a new group always contains at least |targetId|). Returns
+  # the id of the group the tab was attached to.
+  command attachTabToGroup
+    parameters
+      # The CDP target id of the tab.
+      string targetId
+      # The id of an existing group, or empty to create a new one.
+      optional string groupId
+      # The group title; used when a new group is created.
+      string title
+      # The group color id; used when a new group is created.
+      integer color
+    returns
+      # The id of the group the tab was attached to.
+      string groupId
+
+  # Detaches the tab |targetId| from its group; the tab is kept.
+  command detachTabFromGroup
+    parameters
+      # The CDP target id of the tab.
+      string targetId
+
+  # Renames and recolors the existing group |groupId|.
+  command updateTabGroup
+    parameters
+      # The id of the group.
+      string groupId
+      # The new group title.
+      string title
+      # The new group color id.
+      integer color
+
+  # Sets a display-only title prefix on the tab |targetId|; an empty prefix
+  # clears it. The document title is not modified.
+  command setTabTitlePrefix
+    parameters
+      # The CDP target id of the tab.
+      string targetId
+      # The prefix to display before the tab title.
+      string prefix
+
+  # Returns all tab groups with their current members.
+  command getTabGroups
+    returns
+      # The tab groups of all current browser windows.
+      array of TabGroupInfo groups
+
+  # Removes the group |groupId|; its tabs are kept, ungrouped.
+  command closeTabGroup
+    parameters
+      # The id of the group to remove.
+      string groupId
