--- /dev/null
+++ b/chrome/browser/devtools/protocol/edi_handler.h
@@ -0,0 +1,49 @@
+// Copyright (c) 2026 Wellington Moreno. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Browser-level handler for the EDI CDP domain: tab group operations and
+// display-only tab title prefixes, used by the built-in MCP sidecar.
+//
+// All methods operate on the TabStripModels of the current browser windows
+// and must be called on the browser process UI thread.
+
+#ifndef CHROME_BROWSER_DEVTOOLS_PROTOCOL_EDIT_HANDLER_H_
+#define CHROME_BROWSER_DEVTOOLS_PROTOCOL_EDIT_HANDLER_H_
+
+#include <memory>
+#include <optional>
+#include <string>
+
+#include "chrome/browser/devtools/protocol/edi.h"
+
+class EdiHandler : public protocol::Edi::Backend {
+ public:
+  explicit EdiHandler(protocol::UberDispatcher* dispatcher);
+
+  EdiHandler(const EdiHandler&) = delete;
+  EdiHandler& operator=(const EdiHandler&) = delete;
+
+  ~EdiHandler() override;
+
+  // protocol::Edi::Backend:
+  protocol::Response AttachTabToGroup(
+      const std::string& in_target_id,
+      std::optional<std::string> in_group_id,
+      const std::string& in_title,
+      int in_color,
+      std::string* out_group_id) override;
+  protocol::Response DetachTabFromGroup(
+      const std::string& in_target_id) override;
+  protocol::Response UpdateTabGroup(const std::string& in_group_id,
+                                    const std::string& in_title,
+                                    int in_color) override;
+  protocol::Response SetTabTitlePrefix(const std::string& in_target_id,
+                                       const std::string& in_prefix) override;
+  protocol::Response GetTabGroups(
+      std::unique_ptr<protocol::Array<protocol::Edi::TabGroupInfo>>*
+          out_groups) override;
+  protocol::Response CloseTabGroup(const std::string& in_group_id) override;
+};
+
+#endif  // CHROME_BROWSER_DEVTOOLS_PROTOCOL_EDIT_HANDLER_H_
diff --git a/chrome/browser/devtools/protocol/edi_handler.cc b/chrome/browser/devtools/protocol/edi_handler.cc
new file mode 100644
index 0000000000..ca7e136
--- /dev/null
+++ b/chrome/browser/devtools/protocol/edi_handler.cc
@@ -0,0 +1,258 @@
+// Copyright (c) 2026 Wellington Moreno. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/devtools/protocol/edi_handler.h"
+
+#include <algorithm>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/edi/edi_tab_title_prefix.h"
+#include "chrome/browser/ui/browser_ui_controller/browser_ui_controller.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface_iterator.h"
+#include "chrome/browser/ui/tabs/tab_change_type.h"
+#include "chrome/browser/ui/tabs/tab_group_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "components/tab_groups/tab_group_color.h"
+#include "components/tab_groups/tab_group_id.h"
+#include "components/tab_groups/tab_group_visual_data.h"
+#include "components/tabs/public/tab_group.h"
+#include "components/tabs/public/tab_interface.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/gfx/range/range.h"
+
+namespace {
+
+// Resolves the CDP target id to the tab that owns it, if any.
+tabs::TabInterface* FindTabForTargetId(const std::string& target_id) {
+  content::DevToolsAgentHost* host =
+      content::DevToolsAgentHost::GetForId(target_id).get();
+  if (!host) {
+    return nullptr;
+  }
+  content::WebContents* web_contents = host->GetWebContents();
+  if (!web_contents) {
+    return nullptr;
+  }
+  return tabs::TabInterface::MaybeGetFromContents(web_contents);
+}
+
+// The CDP target id of the tab, creating the agent host if needed.
+std::string TargetIdForTab(tabs::TabInterface* tab) {
+  return content::DevToolsAgentHost::GetOrCreateForTab(tab->GetContents())
+      ->GetId();
+}
+
+// The group with |group_id| in |model|, if any.
+std::optional<tab_groups::TabGroupId> FindGroup(TabStripModel* model,
+                                                const std::string& group_id) {
+  for (const tab_groups::TabGroupId& id :
+       model->group_model()->ListTabGroups()) {
+    if (id.ToString() == group_id) {
+      return id;
+    }
+  }
+  return std::nullopt;
+}
+
+// The TabStripModel owning the group with |group_id|, across all current
+// windows (or nullptr if no window has it).
+TabStripModel* FindModelForGroup(const std::string& group_id) {
+  TabStripModel* found_model = nullptr;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* window) {
+        TabStripModel* model = window->GetTabStripModel();
+        if (!model) {
+          return true;
+        }
+        if (FindGroup(model, group_id).has_value()) {
+          found_model = model;
+          return false;
+        }
+        return true;
+      });
+  return found_model;
+}
+
+int ClampColor(int color) {
+  return std::clamp(color, 0,
+                    static_cast<int>(tab_groups::TabGroupColorId::kNumEntries) -
+                        1);
+}
+
+}  // namespace
+
+EdiHandler::EdiHandler(protocol::UberDispatcher* dispatcher) {
+  // Dispatcher can be null in tests.
+  if (dispatcher) {
+    protocol::Edi::Dispatcher::wire(dispatcher, this);
+  }
+}
+
+EdiHandler::~EdiHandler() = default;
+
+protocol::Response EdiHandler::AttachTabToGroup(
+    const std::string& in_target_id,
+    std::optional<std::string> in_group_id,
+    const std::string& in_title,
+    int in_color,
+    std::string* out_group_id) {
+  tabs::TabInterface* tab = FindTabForTargetId(in_target_id);
+  if (!tab) {
+    return protocol::Response::InvalidRequest(
+        "no tab for the given target id");
+  }
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  TabStripModel* model = window ? window->GetTabStripModel() : nullptr;
+  if (!model) {
+    return protocol::Response::InvalidRequest("tab has no tab strip model");
+  }
+  const int index = model->GetIndexOfTab(tab);
+
+  std::optional<tab_groups::TabGroupId> group_id =
+      (in_group_id.has_value() && !in_group_id->empty())
+          ? FindGroup(model, *in_group_id)
+          : std::nullopt;
+  if (group_id.has_value()) {
+    model->AddToExistingGroup({index}, *group_id);
+  } else {
+    // A new group always contains at least this tab.
+    group_id = model->AddToNewGroup({index});
+    model->ChangeTabGroupVisuals(
+        *group_id,
+        tab_groups::TabGroupVisualData(base::UTF8ToUTF16(in_title),
+                                       static_cast<tab_groups::TabGroupColorId>(
+                                           ClampColor(in_color))),
+        /*is_customized=*/true);
+  }
+  *out_group_id = group_id->ToString();
+  return protocol::Response::Success();
+}
+
+protocol::Response EdiHandler::DetachTabFromGroup(
+    const std::string& in_target_id) {
+  tabs::TabInterface* tab = FindTabForTargetId(in_target_id);
+  if (!tab) {
+    return protocol::Response::InvalidRequest(
+        "no tab for the given target id");
+  }
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  TabStripModel* model = window ? window->GetTabStripModel() : nullptr;
+  if (!model) {
+    return protocol::Response::Success();  // Nothing to detach.
+  }
+  model->RemoveFromGroup({model->GetIndexOfTab(tab)});
+  return protocol::Response::Success();
+}
+
+protocol::Response EdiHandler::UpdateTabGroup(const std::string& in_group_id,
+                                              const std::string& in_title,
+                                              int in_color) {
+  TabStripModel* model = FindModelForGroup(in_group_id);
+  if (!model) {
+    return protocol::Response::InvalidRequest("no such group");
+  }
+  std::optional<tab_groups::TabGroupId> group_id =
+      FindGroup(model, in_group_id);
+  if (!group_id.has_value()) {
+    return protocol::Response::InvalidRequest("no such group");
+  }
+  model->ChangeTabGroupVisuals(
+      *group_id,
+      tab_groups::TabGroupVisualData(base::UTF8ToUTF16(in_title),
+                                     static_cast<tab_groups::TabGroupColorId>(
+                                         ClampColor(in_color))),
+      /*is_customized=*/true);
+  return protocol::Response::Success();
+}
+
+protocol::Response EdiHandler::SetTabTitlePrefix(
+    const std::string& in_target_id, const std::string& in_prefix) {
+  tabs::TabInterface* tab = FindTabForTargetId(in_target_id);
+  if (!tab) {
+    return protocol::Response::InvalidRequest(
+        "no tab for the given target id");
+  }
+  EdiTabTitlePrefix* prefix = EdiTabTitlePrefix::From(tab);
+  prefix->SetPrefix(base::UTF8ToUTF16(in_prefix));
+  // Refresh the tab strip display; the document title is untouched.
+  BrowserWindowInterface* window = tab->GetBrowserWindowInterface();
+  if (BrowserUiController* controller =
+          BrowserUiController::From(window)) {
+    controller->NotifyTabUIChanged(tab, TabChangeType::kAll);
+  }
+  return protocol::Response::Success();
+}
+
+protocol::Response EdiHandler::GetTabGroups(
+    std::unique_ptr<protocol::Array<protocol::Edi::TabGroupInfo>>*
+        out_groups) {
+  auto groups = std::make_unique<protocol::Array<protocol::Edi::TabGroupInfo>>();
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* window) {
+        TabStripModel* model = window->GetTabStripModel();
+        if (!model) {
+          return true;
+        }
+        for (const tab_groups::TabGroupId& id :
+             model->group_model()->ListTabGroups()) {
+          TabGroup* group = model->group_model()->GetTabGroup(id);
+          if (!group) {
+            continue;
+          }
+          std::string title;
+          int color = 0;
+          if (const tab_groups::TabGroupVisualData* visuals =
+                  group->visual_data()) {
+            title = base::UTF16ToUTF8(visuals->title());
+            color = static_cast<int>(visuals->color());
+          }
+          auto tab_ids = std::make_unique<protocol::Array<std::string>>();
+          const gfx::Range tab_range = group->ListTabs();
+          for (int i = tab_range.start(); i < tab_range.end(); ++i) {
+            if (tabs::TabInterface* tab = model->GetTabAtIndex(i)) {
+              tab_ids->push_back(TargetIdForTab(tab));
+            }
+          }
+          groups->push_back(protocol::Edi::TabGroupInfo::Create()
+                                .SetId(id.ToString())
+                                .SetTitle(title)
+                                .SetColor(color)
+                                .SetTabIds(std::move(tab_ids))
+                                .Build());
+        }
+        return true;
+      });
+  *out_groups = std::move(groups);
+  return protocol::Response::Success();
+}
+
+protocol::Response EdiHandler::CloseTabGroup(const std::string& in_group_id) {
+  TabStripModel* model = FindModelForGroup(in_group_id);
+  if (!model) {
+    return protocol::Response::Success();  // Already gone.
+  }
+  std::optional<tab_groups::TabGroupId> group_id =
+      FindGroup(model, in_group_id);
+  if (!group_id.has_value()) {
+    return protocol::Response::Success();
+  }
+  TabGroup* group = model->group_model()->GetTabGroup(*group_id);
+  if (!group) {
+    return protocol::Response::Success();
+  }
+  // Ungroup every member; the tabs themselves are kept.
+  std::vector<int> indices;
+  const gfx::Range tab_range = group->ListTabs();
+  for (int i = tab_range.start(); i < tab_range.end(); ++i) {
+    indices.push_back(i);
+  }
+  model->RemoveFromGroup(indices);
+  return protocol::Response::Success();
+}
