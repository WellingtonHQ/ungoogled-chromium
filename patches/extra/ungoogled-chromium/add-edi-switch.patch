 int ChromeBrowserMainParts::PreMainMessageLoopRun() {
   TRACE_EVENT0("startup", "ChromeBrowserMainParts::PreMainMessageLoopRun");
 
+  // Launch the bundled EDI MCP sidecar, if enabled via the --edi switch
+  // (chrome://flags "EDI MCP Sidecar"). The sidecar discovers the browser's
+  // CDP endpoint from the DevToolsActivePort file written by the DevTools
+  // HTTP server, and serves MCP on an ephemeral loopback port.
+  if (base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII("edi") ==
+      "enable") {
+    mcp_sidecar_launcher_ = McpSidecarLauncher::Start(
+        base::FilePath::Dirname(base::PathService::CheckedGet(base::FILE_EXE)),
+        base::PathService::CheckedGet(chrome::DIR_USER_DATA));
+  }
